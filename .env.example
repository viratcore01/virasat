# ─────────────────────────────────────────────────────────────────────────────
# VIRASAT — Closed Beta Environment Variables
# Copy this file to .env.local and fill in real values.
# Do NOT commit .env.local or real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB connection string (Atlas recommended for production).
# Get one free at https://www.mongodb.com/atlas/database-free-tier
MONGODB_URI=mongodb+srv://<USER>:<PASSWORD>@cluster0.mongodb.net/virasat?retryWrites=true&w=majority

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here
NEXTAUTH_SECRET=your_nextauth_secret_here

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Sign up at https://resend.com and create a sender domain.
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=noreply@virasat.in

# ─── AI (Gemini) ─────────────────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# ─── Payments (Razorpay Test Mode) ───────────────────────────────────────────
# Get test keys at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_PLAN_ID_MONTHLY=plan_...
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ─── Storage (Cloudflare R2 / S3-compatible) ─────────────────────────────────
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=virasat-uploads

# ─── Cron ────────────────────────────────────────────────────────────────────
# Secret used to authenticate Vercel Cron jobs.
CRON_SECRET=your_cron_secret_here

# ─── WhatsApp (Meta Cloud) ───────────────────────────────────────────────────
# Optional. Leave blank to disable WhatsApp notifications.
WHATSAPP_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_ID=your_phone_id_here

# ─── SMS (MSG91 / Twilio) ────────────────────────────────────────────────────
# Optional. Leave blank to disable SMS notifications.
MSG91_AUTH_KEY=your_msg91_key
MSG91_SENDER_ID=VIRSAT
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_FROM_NUMBER=+1234567890

# ─── Voice/Video Upload (optional) ───────────────────────────────────────────
UPLOADTHING_TOKEN=your_uploadthing_token
