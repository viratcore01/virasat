# ─── DATABASE ───
MONGODB_URI=your_value_here

# ─── AUTH ───
JWT_SECRET=your_value_here
NEXTAUTH_SECRET=your_value_here
NEXTAUTH_URL=your_value_here

# ─── RESEND (Email) ───
RESEND_API_KEY=your_value_here
FROM_EMAIL=your_value_here

# ─── WHATSAPP (Meta Cloud API) ───
WHATSAPP_TOKEN=your_value_here
WHATSAPP_PHONE_ID=your_value_here
WHATSAPP_VERIFY_TOKEN=your_value_here

# ─── CLOUDFLARE R2 (File Storage) ───
R2_ACCOUNT_ID=your_value_here
R2_ACCESS_KEY_ID=your_value_here
R2_SECRET_ACCESS_KEY=your_value_here
R2_BUCKET_NAME=your_value_here
R2_PUBLIC_URL=your_value_here

# ─── OPENAI (AI-Powered Features) ───
OPENAI_API_KEY=your_value_here
NEXT_PUBLIC_APP_URL=your_value_here
CRON_SECRET=your_value_here
DELIVERY_SECRET=your_value_here
NEXT_PUBLIC_FREE_ONLY=true

# â”€â”€â”€ PAYMENTS (optional) â”€â”€â”€
# Only required if NEXT_PUBLIC_FREE_ONLY=false
RAZORPAY_KEY_ID=your_value_here
RAZORPAY_KEY_SECRET=your_value_here
RAZORPAY_PLAN_ID=your_value_here
RAZORPAY_WEBHOOK_SECRET=your_value_here
